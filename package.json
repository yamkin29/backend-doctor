{
	"name": "backend-doctor",
	"version": "0.1.0",
	"description": "Deterministic static analyzer for Node.js/NestJS backends.",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"backend-doctor": "./dist/bin/backend-doctor.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"commander": "^14.0.0",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/node": "^22.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.6.0",
		"vitest": "^3.0.0"
	}
}
